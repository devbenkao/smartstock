{
  "expo": {
    "name": "SmartStock",
    "slug": "smartstock",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#3D9E5A"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.smartstock.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#3D9E5A"
      },
      "package": "com.smartstock.app"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": []
  }
}
